# Copy to .env and fill in. Never commit .env.

# ── LLM 제공자 키 (content.provider 에 맞는 것만 채우면 됨) ───────────────
# 무료 권장: Google Gemini — https://aistudio.google.com/apikey 에서 무료 키 발급
GEMINI_API_KEY=

# 완전 무료·로컬: Ollama 를 쓰면 키가 필요 없습니다(아무것도 입력 안 함).
#   설치: https://ollama.com  →  실행 후  `ollama pull qwen2.5:7b`
#   config.json 에서 "content": { "provider": "ollama" } 로 설정.

# (선택, 유료) Claude 를 쓰려면 — content.provider="anthropic" 일 때만 필요
ANTHROPIC_API_KEY=

# ── 선택 옵션 ───────────────────────────────────────────────
# 네이버 데이터랩 검색어 트렌드 (주제 발굴 교차검증) — https://developers.naver.com/apps
NAVER_DATALAB_CLIENT_ID=
NAVER_DATALAB_CLIENT_SECRET=

# AI 비임상 이미지 생성. 비우면 인포그래픽으로 폴백.
#   provider="huggingface" (무료 권장): https://huggingface.co/settings/tokens 에서 토큰(hf_...) 발급.
#       config.json 의 images.ai_model 예: "black-forest-labs/FLUX.1-schnell"
#   provider="gemini": 위 GEMINI_API_KEY 와 같은 키(단, 무료등급 이미지 할당량이 0인 경우 많음).
#   provider="openai": OpenAI 키(유료).
IMAGE_API_PROVIDER=huggingface
IMAGE_API_KEY=
