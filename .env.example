# Copy to .env and fill in. Never commit .env.

# Required — Claude API (content/topic/SEO generation)
ANTHROPIC_API_KEY=sk-ant-...

# Optional — Naver DataLab search-trend API (topic discovery cross-check)
# https://developers.naver.com/apps  ->  "데이터랩(검색어 트렌드)"
NAVER_DATALAB_CLIENT_ID=
NAVER_DATALAB_CLIENT_SECRET=

# Optional — external image-generation API for non-clinical concept/illustration images.
# Leave blank to disable AI image generation (infographics + your own photos still work).
IMAGE_API_PROVIDER=          # e.g. "openai"  (pluggable; blank = disabled)
IMAGE_API_KEY=
