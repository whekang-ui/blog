{
  "blog": {
    "naver_id": "your_naver_id",
    "write_url": "https://blog.naver.com/your_naver_id?Redirect=Write",
    "specialty": "피부과",
    "clinic_name": "",
    "author_persona": "환자에게 친절하게 설명하는 피부과 전문의"
  },
  "content": {
    "provider": "gemini",
    "model": "gemini-2.5-flash",
    "ollama_host": "http://localhost:11434",
    "min_chars": 1500,
    "target_chars": 2200,
    "language": "ko",
    "_comment": "provider: 'gemini'(무료 권장) | 'ollama'(완전무료·로컬) | 'anthropic'(유료). ollama 사용 시 model 예: 'qwen2.5:7b'"
  },
  "seo": {
    "min_score": 80,
    "max_regeneration_rounds": 2
  },
  "images": {
    "ai_images_enabled": true,
    "ai_model": "gemini-2.5-flash-image",
    "ai_size": "1024x1024",
    "infographics_enabled": true,
    "min_images_per_post": 3,
    "user_photo_dir": "user_photos",
    "output_dir": "generated_media",
    "_comment": "ai_images_enabled=true 면 비임상 개념/모델 이미지를 IMAGE_API_PROVIDER 로 생성(임상사진은 차단). 정보성 자리에는 인포그래픽, 그 외 자리에는 AI 이미지가 들어감."
  },
  "publishing": {
    "require_human_approval": true,
    "max_posts_per_day": 2,
    "humanize": true,
    "default_visibility": "private",
    "use_native_schedule": true
  },
  "automation": {
    "assets_dir": "assets",
    "match_confidence": 0.8,
    "min_action_delay_sec": 0.5,
    "max_action_delay_sec": 2.5,
    "schedule_date_format": "%Y.%m.%d",
    "schedule_time_format": "%H:%M"
  }
}
